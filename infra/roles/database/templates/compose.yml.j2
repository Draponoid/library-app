services:
  db:
    image: {{ lab_db_image | to_json }}
    user: "70:70"
    env_file: .env
    environment:
      POSTGRES_DB: library
      POSTGRES_USER: library
    ports:
      - "{{ lab_bind_address }}:{{ lab_db_port }}:5432"
    volumes:
      - db-data:/var/lib/postgresql/data
      - ./001-schema.sql:/docker-entrypoint-initdb.d/001-schema.sql:ro
    restart: unless-stopped
    mem_limit: 512m
    cpus: 1.0
    healthcheck:
      test: [CMD-SHELL, 'pg_isready -U library -d library']
      interval: 10s
      timeout: 3s
      retries: 5
volumes:
  db-data:
