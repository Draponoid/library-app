x-app: &app
  image: {{ lab_app_image | to_json }}
  user: '10001:10001'
  env_file: .env
  networks: [backend, outbound]
  restart: unless-stopped
  mem_limit: 256m
  cpus: 0.5
  stop_grace_period: 30s
  security_opt: [no-new-privileges:true]
  healthcheck:
    test: [CMD, python, -c, "import urllib.request; urllib.request.urlopen('http://127.0.0.1:5000/health', timeout=2)"]
    interval: 10s
    timeout: 3s
    start_period: 20s
    retries: 3
services:
  app1:
    <<: *app
  app2:
    <<: *app
  nginx:
    image: {{ lab_nginx_image | to_json }}
    user: "101:101"
    ports:
      - "{{ lab_bind_address }}:{{ lab_http_port }}:8080"
    volumes:
      - ./nginx.conf:/etc/nginx/nginx.conf:ro
    depends_on:
      app1: {condition: service_healthy}
      app2: {condition: service_healthy}
    networks: [backend, public]
    restart: unless-stopped
    mem_limit: 128m
    cpus: 0.25
    healthcheck:
      test: [CMD, wget, -q, -O, /dev/null, http://127.0.0.1:8080/health]
      interval: 10s
      timeout: 3s
      retries: 3
networks:
  backend:
    internal: true
  outbound:
  public:
