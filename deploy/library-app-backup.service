[Unit]
Description=Independent library PostgreSQL backup on application VM
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
EnvironmentFile=/etc/labapp/labapp.env
Environment=PATH=/usr/lib/postgresql/18/bin:/usr/bin:/bin
ExecStart=/usr/bin/python3 /usr/local/lib/library-backup/postgres_backup.py --output-directory /var/backups/library/application --prefix library-app
TimeoutStartSec=1h
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/backups/library/application

