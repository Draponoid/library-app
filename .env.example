# Copy to .env. Generate a new random key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-random-string-at-least-32-characters
DATABASE_PATH=data/library.sqlite3
# PostgreSQL is optional; the server uses its existing /etc/labapp/labapp.env.
# DB_HOST=192.168.204.21
# DB_PORT=5432
# DB_NAME=library
# DB_USER=labapp
# DB_PASSWORD=replace-locally-never-commit
HOST=127.0.0.1
PORT=5000
SESSION_HOURS=8
COOKIE_SECURE=false
LOAN_DAYS=14
MAX_ACTIVE_LOANS=5
# Used ONLY by: python app.py init-demo
DEMO_LIBRARIAN_PASSWORD=ChangeMe-Library-2026!
DEMO_READER_PASSWORD=ChangeMe-Reader-2026!
